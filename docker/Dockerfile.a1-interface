# Dedicated Dockerfile for A1 Interface Component
# Optimized for REST API and policy management

# Stage 1: Build stage
FROM golang:1.21-alpine3.18 AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    ca-certificates \
    tzdata \
    gcc \
    musl-dev \
    linux-headers \
    && update-ca-certificates

# Create build user
RUN adduser -D -g '' a1builder

WORKDIR /build

# Copy dependency files
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Copy source code
COPY . .

# Build A1 interface component
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a -installsuffix cgo \
    -o a1-interface \
    ./cmd/a1-interface/main.go

# Stage 2: Runtime
FROM alpine:3.18 AS runtime

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    curl \
    && update-ca-certificates

# Create a1 user
RUN adduser -D -g '' a1user

# Create directories
RUN mkdir -p /app/configs /app/policies /app/models /app/logs && \
    chown -R a1user:a1user /app

# Copy binary and configs
COPY --from=builder /build/a1-interface /app/a1-interface
COPY --from=builder /build/configs/a1-config.yaml /app/configs/

# Set ownership
RUN chown -R a1user:a1user /app

USER a1user
WORKDIR /app

# Expose A1 ports (HTTP/HTTPS)
EXPOSE 8080 8443

# Health check for A1 interface
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/a1/health || exit 1

CMD ["./a1-interface"]